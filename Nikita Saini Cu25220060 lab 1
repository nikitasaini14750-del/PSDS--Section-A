#include <iostream>
using namespace std;

int stack[5];
int top = -1;

// PUSH
void push(int value)
{
    if (top == 4)
    {
        cout << "Stack Overflow!" << endl;
    }
    else
    {
        top++;
        stack[top] = value;
        cout << value << " pushed" << endl;
    }
}

// POP
void pop()
{
    if (top == -1)
    {
        cout << "Stack Underflow!" << endl;
    }
    else
    {
        cout << stack[top] << " popped" << endl;
        top--;
    }
}

int main()
{
    push(10);
    push(20);
    push(30);

    pop();
    pop();

    cout << "Remaining stack: ";

    for (int i = top; i >= 0; i--)
    {
        cout << stack[i] << " ";
    }

    return 0;
}
