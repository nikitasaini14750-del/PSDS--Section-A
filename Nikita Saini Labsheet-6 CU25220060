//1. 3Sum Problem:
#include <iostream>
using namespace std;

int main() {
    int arr[] = {5, 6, -3, 8, 1, 9, 2};
    int n = 7;

    for (int i = 0; i < n - 2; i++) {
        for (int j = i + 1; j < n - 1; j++) {
            for (int k = j + 1; k < n; k++) {

                if (arr[i] + arr[j] + arr[k] == 0) {
                    cout << "Triplet: ";
                    cout << arr[i] << " ";
                    cout << arr[j] << " ";
                    cout << arr[k] << endl;
                }
            }
        }
    }

    return 0;
} 

//2. Fabonacci Series:
 
#include <iostream>
using namespace std;

int main() {
    int n = 5;
    int a = 1, b = 1;

    cout << "Fibonacci Series: ";

    for (int i = 1; i <= n; i++) {
        cout << a << " ";

        int c = a + b;
        a = b;
        b = c;
    }

    return 0;
}

//3.Tower of Hanoi:
#include <iostream>
using namespace std;

void hanoi(int n, char source, char helper, char destination) {

    if (n == 1) {
        cout << "Move disk 1 from "
             << source << " to " << destination << endl;
        return;
    }

    hanoi(n - 1, source, destination, helper);

    cout << "Move disk " << n << " from "
         << source << " to " << destination << endl;

    hanoi(n - 1, helper, source, destination);
}

int main() {
    int n = 3;

    hanoi(n, 'A', 'B', 'C');

    return 0;
}
