#include <iostream>
#include <vector>
#include <climits>
using namespace std;

int main()
{
    int n, m, k;
    cin >> n >> m >> k;

    vector<int> u(m), v(m), w(m);

    // Input edges
    for(int i = 0; i < m; i++)
    {
        cin >> u[i] >> v[i] >> w[i];
    }

    const long long INF = LLONG_MAX / 4;

    vector<long long> dist(n + 1, INF);

    dist[1] = 0;

    // Allow at most k edges
    for(int step = 1; step <= k; step++)
    {
        vector<long long> next = dist;

        for(int i = 0; i < m; i++)
        {
            int a = u[i];
            int b = v[i];
            int cost = w[i];

            // a to b
            if(dist[a] != INF)
            {
                long long newCost = dist[a] + cost;

                if(newCost < next[b])
                {
                    next[b] = newCost;
                }
            }

            // b to a (undirected graph)
            if(dist[b] != INF)
            {
                long long newCost = dist[b] + cost;

                if(newCost < next[a])
                {
                    next[a] = newCost;
                }
            }
        }

        dist = next;
    }

    if(dist[n] == INF)
    {
        cout << -1;
    }
    else
    {
        cout << "Minimum Path Weight = " << dist[n];
    }

    return 0;
}
