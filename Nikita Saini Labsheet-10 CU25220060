#include <iostream>
#include <map>
using namespace std;

int digitSum(int n)
{
    int sum = 0;

    while (n > 0)
    {
        sum += n % 10;
        n = n / 10;
    }

    return sum;
}

long long solve(int N, int nums[])
{
    map<int, long long> freq;

    for (int i = 0; i < N; i++)
    {
        int sum = digitSum(nums[i]);
        freq[sum]++;
    }

    long long ans = 0;

    for (auto x : freq)
    {
        long long count = x.second;

        // Ordered pairs, i != j
        ans += count * (count - 1);
    }

    return ans * 2;
}

int main()
{
    int N;
    cin >> N;

    int nums[N];

    for (int i = 0; i < N; i++)
    {
        cin >> nums[i];
    }

    cout << solve(N, nums);

    return 0;
}
